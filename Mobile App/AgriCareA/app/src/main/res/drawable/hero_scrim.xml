<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the hero photo top-to-bottom so white type keeps contrast over grass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/hero_scrim_top"
        android:centerColor="#B3000000"
        android:endColor="@color/hero_scrim_bottom"
        android:type="linear" />
</shape>
