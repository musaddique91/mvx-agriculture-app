<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AgriCareA" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="shapeAppearanceCornerSmall">@style/Shape.AgriCare.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.AgriCare.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.AgriCare.Large</item>

        <item name="bottomNavigationStyle">@style/Widget.AgriCare.BottomNav</item>
    </style>

    <style name="Theme.AgriCareA.Hero" parent="Theme.AgriCareA">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Shapes -->
    <style name="Shape.AgriCare.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.AgriCare.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Shape.AgriCare.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>
    <style name="Shape.AgriCare.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Shape.AgriCare.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.AgriCare.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
    </style>
    <style name="Widget.AgriCare.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.AgriCare.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
    <style name="Widget.AgriCare.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!-- A chip that opens a list, used for the Mandi filters -->
    <style name="Widget.AgriCare.Chip.Dropdown" parent="Widget.Material3.Chip.Assist">
        <item name="chipIconVisible">true</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="closeIcon">@drawable/ic_arrow_drop_down</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxWidth">220dp</item>
    </style>

    <!-- Cards -->
    <style name="Widget.AgriCare.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AgriCare.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.AgriCare.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.AgriCare.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Reusable text roles -->
    <style name="Text.Section" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- Heading above a group of cards -->
    <style name="Text.GroupHeading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        Urdu is set in Nastaliq: a much taller, sloped script that the default
        sans-serif cannot render properly. Applied as an overlay at runtime rather
        than a values-ur theme, so it merges with the palette instead of replacing
        it — a language-qualified theme would outrank values-night and strand Urdu
        users in light colours.
    -->
    <style name="ThemeOverlay.AgriCare.Urdu" parent="">
        <item name="fontFamily">@font/noto_nastaliq_urdu</item>
        <item name="android:fontFamily">@font/noto_nastaliq_urdu</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <!--
        Soft UI. Inherits everything structural from the default theme and only
        restates the palette; the moulded surfaces themselves are applied by
        SoftTheme, because Material bakes card and field backgrounds into their
        own drawables where a theme cannot reach.
    -->
    <style name="Theme.AgriCareA.Soft" parent="Theme.AgriCareA">
        <item name="colorPrimary">@color/soft_primary</item>
        <item name="colorOnPrimary">@color/soft_on_primary</item>
        <item name="colorPrimaryContainer">@color/soft_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/soft_on_primary_container</item>

        <item name="android:colorBackground">@color/soft_surface</item>
        <item name="colorOnBackground">@color/soft_on_surface</item>
        <item name="colorSurface">@color/soft_surface</item>
        <item name="colorOnSurface">@color/soft_on_surface</item>
        <item name="colorSurfaceVariant">@color/soft_surface</item>
        <item name="colorOnSurfaceVariant">@color/soft_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/soft_surface</item>
        <item name="colorSurfaceContainerLow">@color/soft_surface</item>
        <item name="colorSurfaceContainer">@color/soft_surface</item>
        <item name="colorSurfaceContainerHigh">@color/soft_surface</item>
        <item name="colorSurfaceContainerHighest">@color/soft_surface</item>
        <item name="colorOutline">@color/soft_outline</item>
        <item name="colorOutlineVariant">@color/soft_surface</item>

        <!-- Nothing casts a Material shadow: the modelling does that job. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomNavigationStyle">@style/Widget.AgriCare.BottomNav.Soft</item>
    </style>

    <style name="Widget.AgriCare.BottomNav.Soft" parent="Widget.AgriCare.BottomNav">
        <item name="android:background">@color/soft_surface</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
