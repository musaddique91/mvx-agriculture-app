<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xl">

        <!-- Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AgriCare.TextField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:hint="@string/calc_area">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/areaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="@dimen/space_s" android:layout_height="1dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AgriCare.TextField.Dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/calc_unit_acre">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/unitInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/useFieldButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calc_use_field"
            app:icon="@drawable/ic_fields" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AgriCare.TextField.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:hint="@string/calc_crop"
            app:startIconDrawable="@drawable/ic_crop">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/cropInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fertiliser -->
        <TextView style="@style/Text.GroupHeading" android:text="@string/calc_fertiliser" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AgriCare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <TextView
                    android:id="@+id/fertiliserFor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold"
                    tools:text="For 2.5 acre of Rice (Paddy)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include android:id="@+id/doseUrea" layout="@layout/item_dose"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/doseDap" layout="@layout/item_dose"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/doseMop" layout="@layout/item_dose"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/doseSeed" layout="@layout/item_dose"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fertiliserNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Based on the recommended N-P-K dose." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Spray -->
        <TextView style="@style/Text.GroupHeading" android:text="@string/calc_spray" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AgriCare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AgriCare.TextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/calc_dose_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/doseInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space android:layout_width="@dimen/space_s" android:layout_height="1dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AgriCare.TextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/calc_tank_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tankInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:text="15" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include android:id="@+id/sprayWater" layout="@layout/item_dose"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/sprayProduct" layout="@layout/item_dose"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/sprayTanks" layout="@layout/item_dose"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
