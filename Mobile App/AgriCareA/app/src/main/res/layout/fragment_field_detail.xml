<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="96dp">

            <!-- Summary -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AgriCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/detailName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textStyle="bold"
                            tools:text="North plot" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editFieldButton"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/field_edit"
                            app:icon="@drawable/ic_edit"
                            app:iconTint="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        tools:text="2.14 acre · 0.87 ha" />

                    <TextView
                        android:id="@+id/detailCrop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        tools:text="Rice (Paddy)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Crop journey: start a season, or where the standing crop is -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AgriCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <TextView
                        android:id="@+id/journeyCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:text="@string/journey_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_crop"
                        app:drawableTint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/journeyCardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/journey_card_start_body"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/journeyCardButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/journey_start_season" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Farm money card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AgriCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <TextView
                        android:id="@+id/moneyCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:text="@string/money_card_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_wallet"
                        app:drawableTint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/moneyCardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Spent ₹0 · Received ₹0" />

                    <TextView
                        android:id="@+id/moneyCardPending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:drawablePadding="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_pending"
                        tools:text="₹8,000 still to be paid" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/moneyCardButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/money_open" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI advice -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/adviceButton"
                style="@style/Widget.AgriCare.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/field_advice"
                app:icon="@drawable/ic_advice" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/adviceProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:indeterminate="true"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/adviceCard"
                style="@style/Widget.AgriCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone">

                <TextView
                    android:id="@+id/adviceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_m"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textIsSelectable="true"
                    tools:text="Sow groundnut now…" />
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Text.GroupHeading" android:text="@string/field_notes" />

            <TextView
                android:id="@+id/noNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/field_no_notes"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/noteList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_note" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addNoteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_l"
        android:text="@string/field_add_note"
        app:icon="@drawable/ic_note" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
