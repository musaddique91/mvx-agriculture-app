<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Six filters would not fit as stacked fields without pushing the prices
         off screen, so they are one row of chips that scrolls sideways. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_s"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipState"
                style="@style/Widget.AgriCare.Chip.Dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_state"
                tools:text="Karnataka" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDistrict"
                style="@style/Widget.AgriCare.Chip.Dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_location"
                tools:text="Belagavi" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMandi"
                style="@style/Widget.AgriCare.Chip.Dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_mandi"
                tools:text="All mandis" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCommodity"
                style="@style/Widget.AgriCare.Chip.Dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_market"
                tools:text="All commodities" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVariety"
                style="@style/Widget.AgriCare.Chip.Dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_variety"
                tools:text="All varieties"
                tools:visibility="visible" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSort"
                style="@style/Widget.AgriCare.Chip.Dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_sort"
                tools:text="Name A–Z" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/summaryLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Reported 16/09/2026 · 16 listed" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/priceList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingBottom="@dimen/space_xl"
                tools:listitem="@layout/item_mandi_price" />

            <TextView
                android:id="@+id/messageLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="@dimen/space_xl"
                android:paddingEnd="@dimen/space_xl"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="No rates published yet."
                tools:visibility="visible" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
